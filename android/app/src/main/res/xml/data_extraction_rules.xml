<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Privacy by construction (P-01): skin data is never included in cloud
         backup or device-transfer. -->
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>

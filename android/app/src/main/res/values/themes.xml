<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base theme kept minimal; the real styling lives in Compose (Theme.kt).
         Matching the Compose canvas prevents a colour flash on launch. -->
    <style name="Theme.Sunny" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sunny_background</item>
        <item name="android:statusBarColor">@color/sunny_background</item>
        <item name="android:navigationBarColor">@color/sunny_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>

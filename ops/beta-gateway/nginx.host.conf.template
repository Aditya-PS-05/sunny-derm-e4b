# Host-installed Sunny beta gateway. Deployment substitutes __SUNNY_HOST__ and
# __SUNNY_TOKEN__; the rendered file must remain root-readable only.

map_hash_bucket_size 128;

map $http_authorization $sunny_authorized {
    default 0;
    "Bearer __SUNNY_TOKEN__" 1;
}

limit_req_zone $binary_remote_addr zone=sunny_inference_per_ip:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=sunny_model_connections:10m;

log_format sunny_metadata '$remote_addr - $request_method $uri $status '
                          '$body_bytes_sent $request_time';

server {
    listen 80;
    server_name __SUNNY_HOST__;

    location ^~ /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __SUNNY_HOST__;

    ssl_certificate /etc/letsencrypt/live/__SUNNY_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__SUNNY_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:SunnyTLS:10m;

    access_log /var/log/nginx/sunny_access.log sunny_metadata;
    error_log /var/log/nginx/sunny_error.log warn;
    client_max_body_size 8m;
    server_tokens off;

    add_header Cache-Control "no-store" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /v1/chat/completions {
        if ($sunny_authorized = 0) { return 401; }
        limit_req zone=sunny_inference_per_ip burst=5 nodelay;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 30s;
        proxy_buffering off;
    }

    location ~ ^/models/(sunny-pad-smolvlm-500m-v1-gguf/(?:sunny-pad-smolvlm-500m-Q4_K_M\.gguf|sunny-pad-smolvlm-500m-mmproj-Q8_0\.gguf|derm\.gbnf|THIRD_PARTY_NOTICES\.txt|Apache-2\.0\.txt|manifest\.json))$ {
        if ($sunny_authorized = 0) { return 401; }
        limit_conn sunny_model_connections 2;
        limit_except GET HEAD { deny all; }

        alias /srv/sunny-models/$1;
        sendfile on;
        aio threads;
        directio 8m;
        add_header Cache-Control "private, no-store" always;
        add_header Accept-Ranges "bytes" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / { return 404; }
}

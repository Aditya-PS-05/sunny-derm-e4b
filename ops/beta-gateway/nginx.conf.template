map $http_authorization $sunny_inference_authorized {
    default 0;
    "Bearer ${SUNNY_INFERENCE_TOKEN}" 1;
}

map $http_authorization $sunny_contribute_authorized {
    default 0;
    "Bearer ${SUNNY_CONTRIBUTE_TOKEN}" 1;
}

limit_req_zone $binary_remote_addr zone=inference_per_ip:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=contribute_per_ip:10m rate=10r/m;

log_format sunny_metadata '$remote_addr - $request_method $uri $status '
                          '$body_bytes_sent $request_time';

server {
    listen 443 ssl;
    server_name ${SUNNY_BETA_HOST};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    access_log /dev/stdout sunny_metadata;
    error_log /dev/stderr warn;
    client_max_body_size 8m;
    server_tokens off;

    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /health {
        access_log off;
        return 200 "ok\n";
    }

    location = /v1/chat/completions {
        if ($sunny_inference_authorized = 0) { return 401; }
        limit_req zone=inference_per_ip burst=5 nodelay;
        proxy_pass http://${INFERENCE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 30s;
        proxy_buffering off;
    }

    location = /contribute {
        if ($sunny_contribute_authorized = 0) { return 401; }
        limit_req zone=contribute_per_ip burst=2 nodelay;
        proxy_pass http://${CONTRIBUTE_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering off;
    }

    location / { return 404; }
}

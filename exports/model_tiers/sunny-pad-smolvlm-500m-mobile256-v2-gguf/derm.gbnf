root ::= "Lesion Type: " line "\nColour: " line "\nSymmetry: " line "\nBorders: " line "\nTexture: " line "\nSummary: " summary "\nSafety: " disclaimer
line ::= [^\n]{1,48}
summary ::= [^\n]{1,120}
disclaimer ::= "This is a visual description only, not a diagnosis — see a clinician for any concern."
